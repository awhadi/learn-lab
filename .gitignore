.kunsdd/
.DS_Store

# Runtime visit-tracking data (server-local, never source) — see
# service_api.jsp's track_access action. Real IP addresses live in here,
# generated per-deployment, so this must never be committed.
WEB-INF/access-log.tsv
WEB-INF/access-log.tsv.tmp

# Live service config (server-local, per-deployment customization) — must
# never be committed, or every deploy would overwrite the production setup.
# services.default.json (the factory snapshot) stays tracked; the app
# bootstraps services.json from it automatically when missing.
WEB-INF/services.json
WEB-INF/services.json.tmp
